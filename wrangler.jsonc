// Configuration Cloudflare Workers pour FroidPass
// - le site (dossier public) est servi comme fichiers statiques
// - les routes /api/* (paiement FedaPay) passent par worker.js
{
  "name": "froidpasss",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Automatisations : tous les jours à 6 h UTC = 7 h au Bénin
  "triggers": { "crons": ["0 6 * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
